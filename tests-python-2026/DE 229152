from datetime import datetime

n = int(input("Nhap so luong sach (n>0): "))

while n <= 0:
    n = int(input("Nhap so luong sach (n>0): "))


tudien = {}

namhientai = datetime.now().year

for i in range(n):
    MaSoSach = input("Nhap ma so sach: ")
    TenSach = input("Nhap ten sach: ")
    TenTacGia = input("Nhap ten tac gia: ")
    NhaXuatBan = input("Nhap nha xuat ban: ")

    NamXuatBan = int(input("Nhap nam xuat ban: "))

    while NamXuatBan > namhientai:
        NamXuatBan = int(input(
            f"Nam xuat ban khong hop le, vui long nhap nam <= {namhientai}: "
        ))

    tudien[MaSoSach] = [
        TenSach,
        TenTacGia,
        NhaXuatBan,
        NamXuatBan
    ]

print(tudien)

