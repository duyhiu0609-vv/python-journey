def DemChuSoLe(n):
    dem = 0

    while n != 0:
        tam = n % 10

        if tam % 2 != 0:
            dem += 1

        n //= 10

    return dem


print("So luong chu so le la:", DemChuSoLe(n))


##c.

def S(n):
    s = 0

    for i in range(1, n + 1):
        s += 1 / (2 * i)

    return s


print("S =", S(n))
